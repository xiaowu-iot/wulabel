{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wulabel",
  "version": "0.6.6",
  "identifier": "com.xiaowuiot.wulabel",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Wulabel",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: xl: http://xl.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English", "TradChinese", "Japanese", "Korean", "Spanish", "PortugueseBR", "Russian", "German", "French", "Vietnamese", "Indonesian"],
        "displayLanguageSelector": false
      }
    },
    "resources": {
      "../../../worker/xlabel_worker/*.py": "worker/xlabel_worker/",
      "../../../worker/xlabel_worker/yolox/*.py": "worker/xlabel_worker/yolox/",
      "../../../worker/xlabel_worker/locales/*.json": "worker/xlabel_worker/locales/",
      "../../../worker/xlabel_worker/yolox/LICENSE": "worker/xlabel_worker/yolox/LICENSE",
      "../../../worker/service/*": "worker/service/",
      "../../../worker/service-i18n/*": "worker/service-i18n/",
      "../../../NOTICE": "NOTICE"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU1QzNDMTg3RDUwOTcyNzIKUldSeWNnblZoOEhEVlQwakI3NjAwc2kxREVBOXY5WWtsdFYvem1RRkhDM1hiMmx0NzV4K2NtbFoK",
      "endpoints": ["https://feedback.xiaowuiot.com/updater/{{target}}/{{arch}}/{{current_version}}?bundle={{bundle_type}}"],
      "windows": { "installMode": "passive" }
    }
  }
}
