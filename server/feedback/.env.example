# 复制为 .env 并填好。.env 不要提交到仓库。

# 与桌面端 feedback.rs 里的 FEEDBACK_APP_SECRET 必须完全一致（随便设一长串随机字符）
APP_SECRET=CHANGE_ME_shared_secret

# QQ 邮箱 SMTP
# QQ 邮箱 → 设置 → 账户 → 开启「POP3/SMTP 服务」→ 生成授权码
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=你的QQ邮箱@qq.com
SMTP_PASS=QQ邮箱授权码（不是登录密码）
MAIL_FROM=你的QQ邮箱@qq.com

# 收件箱（反馈发到这里，填你自己的邮箱）
FEEDBACK_TO=you@example.com

# 监听端口（本机监听，由前面的反向代理转发过来）
PORT=8787

# 限流（可留默认）
PER_DEVICE_HOUR=5
PER_DEVICE_DAY=20
PER_IP_HOUR=10
GLOBAL_DAY=500

# 限流记录数据库位置
DB_PATH=./feedback.db
